# Optional. The room works without this file: it plays councils you run in Claude Code.
#
# To let the room run councils by itself (billed to your Anthropic API account,
# about 25 calls per full council), copy this file to .env and fill in:

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# "viewer" (default) or "api"
COUNCIL_RUNNER=viewer

# To run through a local OmniRoute gateway instead of Anthropic:
# COUNCIL_RUNNER=api
# AI_PROVIDER=omniroute
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# OMNIROUTE_API_KEY=copy-from-omniroute-dashboard-endpoints
# Use a connected provider/model ID or a free-only combo configured in OmniRoute.
# auto may route to paid providers if you have connected them.
# SEAT_MODEL=auto
# CHAIR_MODEL=auto

# NaraRouter hosted Free plan (no local gateway required):
# COUNCIL_RUNNER=api
# AI_PROVIDER=nara
# NARA_API_KEY=your-key-from-https://router.bynara.id/register
# SEAT_MODEL=nemotron-3.5-lightning-free
# CHAIR_MODEL=nemotron-3.5-lightning-free
# Free-only mode blocks auto and paid aliases, verifies the live Free plan before
# each inference, and stops on quota exhaustion. No fallback to another provider.

# DataForSEO: API Access credentials, kept server-side. Paid requests require per-review approval.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google sign-in: Web application OAuth client; never put its secret in frontend code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: http://localhost:4730/api/google/callback
# Coolify/public deployment (leave PUBLIC_URL blank for local-only use):
PUBLIC_URL=
HOST=
APP_ACCESS_USER=admin
APP_ACCESS_PASSWORD=
GOOGLE_TOKEN_DIR=

# Codex subscription backend: AI_PROVIDER=codex, always gpt-6.1-sol.
# Install official CLI: npm install -g @openai/codex@0.162.1
# Connect through the private app's OpenAI device sign-in. No API key is used.
# Keep these directories private and persistent on the hosted server.
ADVISORY_CODEX_HOME=
ADVISORY_CODEX_WORK=
ADVISORY_CODEX_BIN=

# Optional private reviewed transcript corpus; use /data/advisor-library on Coolify.
# Defaults to ignored knowledge-data/ locally. Bundled curated cards always load.
ADVISOR_LIBRARY_DIR=
